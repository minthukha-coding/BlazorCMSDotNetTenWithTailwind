@page "/cms/edit-home"
@layout MainLayout

<div class="max-w-4xl mx-auto space-y-8">
    
    <!-- Page Header & Language Switcher -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-[#E6E0DD] pb-6 gap-4">
        <div>
            <span class="text-xs uppercase text-[#5C1D24] font-medium block mb-1 tracking-normal">
                CMS Portal • Content Management
            </span>
            <h1 class="text-2xl font-semibold text-[#2D2424]">
                Edit Home Section (Hero)
            </h1>
        </div>

        <div class="flex items-center gap-4">
            <!-- Language Selector Tabs -->
            <div class="inline-flex bg-[#E6E0DD]/60 p-1 rounded-md">
                <button type="button" 
                        @onclick='() => currentLang = "en"'
                        class="px-3 py-1.5 text-xs font-medium rounded transition @(currentLang == "en" ? "bg-[#5C1D24] text-[#FCFBFA]" : "text-[#735A5A] hover:text-[#2D2424]")">
                    🇬🇧 English
                </button>
                <button type="button" 
                        @onclick='() => currentLang = "de"'
                        class="px-3 py-1.5 text-xs font-medium rounded transition @(currentLang == "de" ? "bg-[#5C1D24] text-[#FCFBFA]" : "text-[#735A5A] hover:text-[#2D2424]")">
                    🇩🇪 German
                </button>
            </div>

            <button @onclick="HandleSave" 
                    class="bg-[#5C1D24] hover:bg-[#4A171D] text-[#FCFBFA] px-6 py-2.5 text-xs uppercase font-medium rounded-md transition cursor-pointer">
                Save Changes
            </button>
        </div>
    </div>

    <!-- Edit Form Card -->
    <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-8 shadow-sm">
        <EditForm Model="homeModel" OnValidSubmit="HandleSave">
            <div class="space-y-6">
                
                <!-- Active Language Indicator Notification -->
                <div class="bg-[#5C1D24]/10 border border-[#5C1D24]/20 p-3 rounded-md text-xs text-[#5C1D24] font-medium">
                    You are currently editing content in: <span class="uppercase font-bold">@(currentLang == "en" ? "English (EN)" : "German (DE)")</span>
                </div>

                <!-- Main Title (Conditional based on active language) -->
                <div>
                    <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                        Main Title (@(currentLang.ToUpper()))
                    </label>
                    @if (currentLang == "en")
                    {
                        <InputText @bind-Value="homeModel.MainTitleEn"
                                   class="w-full bg-white border border-[#D9D0CC] px-3.5 py-3 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    }
                    else
                    {
                        <InputText @bind-Value="homeModel.MainTitleDe"
                                   class="w-full bg-white border border-[#D9D0CC] px-3.5 py-3 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    }
                </div>

                <!-- Description Paragraph 1 -->
                <div>
                    <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                        Description Paragraph 1 (@(currentLang.ToUpper()))
                    </label>
                    @if (currentLang == "en")
                    {
                        <InputTextArea @bind-Value="homeModel.Description1En" rows="3"
                                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-3 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    }
                    else
                    {
                        <InputTextArea @bind-Value="homeModel.Description1De" rows="3"
                                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-3 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    }
                </div>

                <!-- Button Text -->
                <div>
                    <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                        Action Button Text (@(currentLang.ToUpper()))
                    </label>
                    @if (currentLang == "en")
                    {
                        <InputText @bind-Value="homeModel.ButtonTextEn"
                                   class="w-full bg-white border border-[#D9D0CC] px-3.5 py-3 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    }
                    else
                    {
                        <InputText @bind-Value="homeModel.ButtonTextDe"
                                   class="w-full bg-white border border-[#D9D0CC] px-3.5 py-3 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    }
                </div>

            </div>
        </EditForm>
    </div>

</div>

@code {
    private string currentLang = "en"; // မူလအနေဖြင့် English ကိုပြမည်

    private HomeSectionModel homeModel = new()
    {
        MainTitleEn = "Connecting Germany and Myanmar Through Business, Trade, and Innovation",
        MainTitleDe = "Deutschland und Myanmar durch Wirtschaft, Handel und Innovation verbinden",
        
        Description1En = "Irrawaddy GmbH is a Munich-based company dedicated to creating business opportunities between Germany and Myanmar.",
        Description1De = "Die Irrawaddy GmbH ist ein in München ansässiges Unternehmen, das sich der Schaffung von Geschäftsmöglichkeiten zwischen Deutschland und Myanmar widmet.",
        
        ButtonTextEn = "CONTACT US",
        ButtonTextDe = "KONTAKT"
    };

    private void HandleSave()
    {
        // ဘာသာစကားနှစ်မျိုးစလုံး၏ ဒေတာများကို Database သို့ တစ်ပါတည်း သိမ်းဆည်းရန်
    }

    public class HomeSectionModel
    {
        // English Fields
        public string MainTitleEn { get; set; } = "";
        public string Description1En { get; set; } = "";
        public string ButtonTextEn { get; set; } = "";

        // German Fields
        public string MainTitleDe { get; set; } = "";
        public string Description1De { get; set; } = "";
        public string ButtonTextDe { get; set; } = "";
    }
}