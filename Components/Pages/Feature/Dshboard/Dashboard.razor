@page "/cms/dashboard"
@using Microsoft.AspNetCore.Authorization
@layout MainLayout
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<div class="max-w-6xl mx-auto space-y-8">
    
    <!-- Welcome Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-[#E6E0DD] pb-6 gap-4">
        <div>
            <span class="text-xs uppercase text-[#5C1D24] font-medium block mb-1 tracking-normal">
                CMS Portal • Overview
            </span>
            <h1 class="text-2xl font-semibold text-[#2D2424]">
                Welcome back, Admin! 👋
            </h1>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-xs text-[#735A5A] bg-[#E6E0DD]/40 px-3 py-1.5 rounded-md font-medium">
                Last Login: Today, 10:45 AM
            </span>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- Total Sections -->
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs uppercase font-medium text-[#735A5A]">Managed Sections</p>
                    <h3 class="text-2xl font-bold text-[#2D2424] mt-1">4</h3>
                </div>
                <div class="p-3 bg-[#F5EFEE] text-[#5C1D24] rounded-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                    </svg>
                </div>
            </div>
            <span class="text-[11px] text-[#5C1D24] mt-3 block font-medium">Home, About, Services, Contact</span>
        </div>

        <!-- Total Languages -->
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs uppercase font-medium text-[#735A5A]">Active Languages</p>
                    <h3 class="text-2xl font-bold text-[#2D2424] mt-1">2</h3>
                </div>
                <div class="p-3 bg-[#F5EFEE] text-[#5C1D24] rounded-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                    </svg>
                </div>
            </div>
            <span class="text-[11px] text-[#5C1D24] mt-3 block font-medium">English & German</span>
        </div>

        <!-- Media Files -->
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs uppercase font-medium text-[#735A5A]">Media Storage</p>
                    <h3 class="text-2xl font-bold text-[#2D2424] mt-1">12 Files</h3>
                </div>
                <div class="p-3 bg-[#F5EFEE] text-[#5C1D24] rounded-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
            </div>
            <span class="text-[11px] text-[#5C1D24] mt-3 block font-medium">Images & Videos Optimized</span>
        </div>

        <!-- System Status -->
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs uppercase font-medium text-[#735A5A]">System Status</p>
                    <h3 class="text-2xl font-bold text-green-700 mt-1">Online</h3>
                </div>
                <div class="p-3 bg-green-50 text-green-700 rounded-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
            <span class="text-[11px] text-[#735A5A] mt-3 block font-medium">Production Server Vercel</span>
        </div>

    </div>

    <!-- Quick Action Cards (Manage Sections) -->
    <div class="space-y-4">
        <h2 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal">
            Quick Content Management
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
            
            <!-- Home Edit Card -->
            <div @onclick="@(() => NavigateTo("/cms/edit-home"))" class="bg-[#FCFBFA] border border-[#E6E0DD] hover:border-[#5C1D24] rounded-lg p-6 shadow-sm transition cursor-pointer group">
                <div class="text-[#5C1D24] mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:scale-110 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-[#2D2424]">Home Section</h3>
                <p class="text-xs text-[#735A5A] mt-1">Edit hero titles, description text, and background media.</p>
            </div>

            <!-- About Edit Card -->
            <div @onclick="@(() => NavigateTo("/cms/edit-about"))" class="bg-[#FCFBFA] border border-[#E6E0DD] hover:border-[#5C1D24] rounded-lg p-6 shadow-sm transition cursor-pointer group">
                <div class="text-[#5C1D24] mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:scale-110 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-[#2D2424]">About Us</h3>
                <p class="text-xs text-[#735A5A] mt-1">Update heritage details, paragraphs, and company logo.</p>
            </div>

            <!-- Service Edit Card -->
            <div @onclick="@(() => NavigateTo("/cms/edit-services"))" class="bg-[#FCFBFA] border border-[#E6E0DD] hover:border-[#5C1D24] rounded-lg p-6 shadow-sm transition cursor-pointer group">
                <div class="text-[#5C1D24] mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:scale-110 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-[#2D2424]">Services</h3>
                <p class="text-xs text-[#735A5A] mt-1">Manage consulting services, packages, and offerings.</p>
            </div>

            <!-- Contact Edit Card -->
            <div @onclick="@(() => NavigateTo("/cms/edit-contact"))" class="bg-[#FCFBFA] border border-[#E6E0DD] hover:border-[#5C1D24] rounded-lg p-6 shadow-sm transition cursor-pointer group">
                <div class="text-[#5C1D24] mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:scale-110 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>
                <h3 class="text-base font-semibold text-[#2D2424]">Contact Info</h3>
                <p class="text-xs text-[#735A5A] mt-1">Update Munich office address, emails, and phone contacts.</p>
            </div>

        </div>
    </div>

    <!-- Recent Activities & System Info Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Recent Activities Log -->
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-6 shadow-sm lg:col-span-2 space-y-4">
            <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal border-b border-[#E6E0DD] pb-2">
                Recent Activity Logs
            </h3>
            
            <div class="space-y-3 text-sm">
                <div class="flex items-center justify-between py-2 border-b border-[#E6E0DD]/60">
                    <div class="flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-green-600"></span>
                        <span class="text-[#2D2424]">Updated <strong>Home Section</strong> background video</span>
                    </div>
                    <span class="text-xs text-[#735A5A]">2 hours ago</span>
                </div>

                <div class="flex items-center justify-between py-2 border-b border-[#E6E0DD]/60">
                    <div class="flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                        <span class="text-[#2D2424]">Modified <strong>About Us</strong> paragraph content</span>
                    </div>
                    <span class="text-xs text-[#735A5A]">Yesterday</span>
                </div>

                <div class="flex items-center justify-between py-2">
                    <div class="flex items-center gap-3">
                        <span class="w-2 h-2 rounded-full bg-purple-600"></span>
                        <span class="text-[#2D2424]">Admin profile information updated</span>
                    </div>
                    <span class="text-xs text-[#735A5A]">3 days ago</span>
                </div>
            </div>
        </div>

        <!-- Quick Profile & Settings Widget -->
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-6 shadow-sm space-y-4">
            <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal border-b border-[#E6E0DD] pb-2">
                Account Security
            </h3>
            
            <div class="space-y-3 text-xs text-[#735A5A]">
                <p>Logged in as <strong class="text-[#2D2424]">Super Administrator</strong>.</p>
                <p>Ensure you keep your credentials secure and log out when finished managing content.</p>
            </div>

            <div class="pt-2">
                <button @onclick="@(() => NavigateTo("/cms/admin-profile"))" 
                        class="w-full bg-white border border-[#5C1D24] hover:bg-[#F5EFEE] text-[#5C1D24] py-2.5 uppercase font-medium rounded-md transition cursor-pointer text-center text-xs">
                    Manage Admin Profile
                </button>
            </div>
        </div>

    </div>

</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is null || !user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }
    }
    
    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }
}