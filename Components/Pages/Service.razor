@page "/cms/edit-services"
@layout MainLayout
@inject NavigationManager Navigation

<div class="max-w-5xl mx-auto space-y-8">
    
    <!-- Page Header -->
    <div class="flex items-center justify-between border-b border-[#E6E0DD] pb-6">
        <div class="flex items-center space-x-4">
            <!-- Back Button -->
            <button @onclick="GoBack" 
                    class="bg-white border border-[#D9D0CC] hover:bg-[#F5EFEE] text-[#5C1D24] p-2 rounded-md transition cursor-pointer flex items-center justify-center"
                    title="Back">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </button>
            <div>
                <span class="text-xs uppercase text-[#5C1D24] font-medium block mb-1 tracking-normal">
                    CMS Portal • Content Management
                </span>
                <h1 class="text-2xl font-semibold text-[#2D2424]">
                    Manage Services Section
                </h1>
            </div>
        </div>
        
        <!-- Add New Service Button -->
        <button @onclick="OpenCreateModal" 
                class="bg-[#5C1D24] hover:bg-[#4A171D] text-[#FCFBFA] px-5 py-2.5 text-xs uppercase font-medium rounded-md transition cursor-pointer flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add New Service
        </button>
    </div>

    <!-- Section Header Settings (Bilateral Expertise & Title) -->
    <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg p-6 shadow-sm space-y-4">
        <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal border-b border-[#E6E0DD] pb-2">
            Section Header Settings
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                    Subtitle (e.g., BILATERAL EXPERTISE)
                </label>
                <input type="text" @bind="sectionSubtitle"
                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
            </div>
            <div>
                <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-2 tracking-normal">
                    Main Title (e.g., Our Services)
                </label>
                <input type="text" @bind="sectionTitle"
                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
            </div>
        </div>
    </div>

    <!-- Services List Section -->
    <div class="space-y-4">
        <h3 class="text-sm font-semibold uppercase text-[#5C1D24] tracking-normal">
            Services List (@servicesList.Count)
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            @foreach (var service in servicesList)
            {
                <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg overflow-hidden shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="h-40 bg-black/5 relative">
                            <img src="@service.ImageUrl" alt="@service.Title" class="w-full h-full object-cover" />
                        </div>
                        <div class="p-5 space-y-2">
                            <h4 class="text-base font-semibold text-[#2D2424]">@service.Title</h4>
                            <p class="text-xs text-[#5C4D4D] line-clamp-3">@service.Description</p>
                        </div>
                    </div>
                    
                    <!-- Card Actions (Edit / Delete) -->
                    <div class="px-5 py-3 bg-white border-t border-[#E6E0DD] flex items-center justify-between">
                        <button @onclick="() => OpenEditModal(service)" 
                                class="text-xs uppercase font-medium text-[#5C1D24] hover:underline flex items-center gap-1 cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                            </svg>
                            Edit
                        </button>
                        <button @onclick="() => PromptDelete(service)" 
                                class="text-xs uppercase font-medium text-red-700 hover:underline flex items-center gap-1 cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            Delete
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<!-- Create / Edit Modal Form -->
@if (isModalOpen)
{
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg max-w-lg w-full p-6 shadow-xl space-y-6 max-h-[90vh] overflow-y-auto">
            
            <div class="flex items-center justify-between border-b border-[#E6E0DD] pb-4">
                <h3 class="text-base font-semibold text-[#2D2424]">
                    @(isEditMode ? "Edit Service" : "Add New Service")
                </h3>
                <button @onclick="CloseModal" class="text-[#735A5A] hover:text-[#2D2424]">
                    ✕
                </button>
            </div>

            <EditForm Model="activeService" OnValidSubmit="SaveService">
                <div class="space-y-4">
                    
                    <div>
                        <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-1">Service Title</label>
                        <InputText @bind-Value="activeService.Title" 
                                   class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    </div>

                    <div>
                        <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-1">Description</label>
                        <InputTextArea @bind-Value="activeService.Description" rows="4"
                                       class="w-full bg-white border border-[#D9D0CC] px-3.5 py-2.5 text-sm text-[#2D2424] focus:outline-none focus:border-[#5C1D24] rounded-md"/>
                    </div>

                    <div>
                        <label class="block text-xs uppercase font-medium text-[#5C4D4D] mb-1">Service Image</label>
                        <InputFile OnChange="HandleFileSelection" class="w-full bg-white border border-[#D9D0CC] p-2 text-xs text-[#2D2424] rounded-md cursor-pointer file:mr-3 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:font-medium file:bg-[#5C1D24] file:text-[#FCFBFA]" />
                        
                        @if (!string.IsNullOrEmpty(activeService.ImageUrl))
                        {
                            <div class="mt-3 h-32 rounded-md overflow-hidden border border-[#E6E0DD]">
                                <img src="@activeService.ImageUrl" alt="Preview" class="w-full h-full object-cover" />
                            </div>
                        }
                    </div>

                    <div class="flex justify-end gap-3 pt-4 border-t border-[#E6E0DD]">
                        <button type="button" @onclick="CloseModal" 
                                class="bg-white border border-[#D9D0CC] text-[#735A5A] hover:bg-[#F5EFEE] px-4 py-2 text-xs uppercase font-medium rounded-md transition">
                            Cancel
                        </button>
                        <button type="submit" 
                                class="bg-[#5C1D24] hover:bg-[#4A171D] text-[#FCFBFA] px-5 py-2 text-xs uppercase font-medium rounded-md transition">
                            Save Service
                        </button>
                    </div>

                </div>
            </EditForm>

        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (isDeleteModalOpen)
{
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg max-w-sm w-full p-6 shadow-xl space-y-6 text-center">
            
            <div class="w-12 h-12 rounded-full bg-red-100 text-red-700 flex items-center justify-center mx-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
            </div>

            <div class="space-y-2">
                <h3 class="text-base font-semibold text-[#2D2424]">Delete Service</h3>
                <p class="text-xs text-[#5C4D4D]">
                    Are you sure you want to delete <span class="font-semibold text-[#2D2424]">"@serviceToDelete?.Title"</span>? This action cannot be undone.
                </p>
            </div>

            <div class="flex justify-center gap-3 pt-2">
                <button type="button" @onclick="CloseDeleteModal" 
                        class="flex-1 bg-white border border-[#D9D0CC] text-[#735A5A] hover:bg-[#F5EFEE] px-4 py-2 text-xs uppercase font-medium rounded-md transition">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmDelete" 
                        class="flex-1 bg-red-700 hover:bg-red-800 text-white px-4 py-2 text-xs uppercase font-medium rounded-md transition">
                    Delete
                </button>
            </div>

        </div>
    </div>
}

@code {
    private string sectionSubtitle = "BILATERAL EXPERTISE";
    private string sectionTitle = "Our Services";

    private List<ServiceModel> servicesList = new()
    {
        new ServiceModel { Id = 1, Title = "Business Consulting", Description = "We provide practical and strategic consulting solutions for businesses seeking growth, efficiency, and international expansion.", ImageUrl = "/images/service-1.jpg" },
        new ServiceModel { Id = 2, Title = "Import & Export", Description = "We facilitate international trade by connecting reliable suppliers and buyers across global markets.", ImageUrl = "/images/service-2.jpg" },
        new ServiceModel { Id = 3, Title = "Hospitality & Gastronomy", Description = "We create authentic hospitality experiences that celebrate cultural diversity and culinary excellence.", ImageUrl = "/images/service-3.jpg" }
    };

    private bool isModalOpen = false;
    private bool isEditMode = false;
    private ServiceModel activeService = new();

    // Delete confirmation state variables
    private bool isDeleteModalOpen = false;
    private ServiceModel? serviceToDelete = null;

    private void GoBack()
    {
        Navigation.NavigateTo("/cms/dashboard");
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        activeService = new ServiceModel();
        isModalOpen = true;
    }

    private void OpenEditModal(ServiceModel service)
    {
        isEditMode = true;
        activeService = new ServiceModel
        {
            Id = service.Id,
            Title = service.Title,
            Description = service.Description,
            ImageUrl = service.ImageUrl
        };
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task HandleFileSelection(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var format = file.ContentType;
            var buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadAsync(buffer);
            activeService.ImageUrl = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
        }
    }

    private void SaveService()
    {
        if (isEditMode)
        {
            var existing = servicesList.FirstOrDefault(s => s.Id == activeService.Id);
            if (existing != null)
            {
                existing.Title = activeService.Title;
                existing.Description = activeService.Description;
                existing.ImageUrl = activeService.ImageUrl;
            }
        }
        else
        {
            activeService.Id = servicesList.Any() ? servicesList.Max(s => s.Id) + 1 : 1;
            servicesList.Add(activeService);
        }
        isModalOpen = false;
    }

    private void PromptDelete(ServiceModel service)
    {
        serviceToDelete = service;
        isDeleteModalOpen = true;
    }

    private void CloseDeleteModal()
    {
        isDeleteModalOpen = false;
        serviceToDelete = null;
    }

    private void ConfirmDelete()
    {
        if (serviceToDelete != null)
        {
            servicesList.Remove(serviceToDelete);
        }
        CloseDeleteModal();
    }

    public class ServiceModel
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string ImageUrl { get; set; } = "";
    }
}