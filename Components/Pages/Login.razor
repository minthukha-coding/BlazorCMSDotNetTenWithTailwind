@page "/"
@layout EmptyLayout

<div class="@($"min-h-screen {BgColor} flex items-center justify-center p-6 transition-colors duration-300")">
    <div class="@($"w-full max-w-6xl grid md:grid-cols-2 {CardBg} rounded-3xl overflow-hidden shadow-2xl border relative")">

        <!-- Theme Toggle Button -->
        @* <button type="button" @onclick="ToggleTheme" *@
        @*         class="@($"absolute top-4 right-4 z-10 p-2 rounded-full {ButtonBg} transition")" *@
        @*         title="Toggle Theme"> *@
        @*     @if (isDarkMode) *@
        @*     { *@
        @*         <!-- Sun Icon for Light Mode --> *@
        @*         <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" *@
        @*              stroke="currentColor"> *@
        @*             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" *@
        @*                   d="M12 3v1m0 16v1m9-9h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/> *@
        @*         </svg> *@
        @*     } *@
        @*     else *@
        @*     { *@
        @*         <!-- Moon Icon for Dark Mode --> *@
        @*         <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" *@
        @*              stroke="currentColor"> *@
        @*             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" *@
        @*                   d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/> *@
        @*         </svg> *@
        @*     } *@
        @* </button> *@
        
        <!-- Theme Toggle Button -->
        <button type="button" @onclick="ToggleTheme"
                class="@($"absolute top-4 right-4 z-10 p-2 rounded-full {ButtonBg} transition cursor-pointer")"
                title="Toggle Theme">
            @if (isDarkMode)
            {
                <!-- Sun Icon for Light Mode -->
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 pointer-events-none" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 3v1m0 16v1m9-9h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
            }
            else
            {
                <!-- Moon Icon for Dark Mode -->
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 pointer-events-none" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                </svg>
            }
        </button>

        <!-- Left Side: GmbH CMS Branding -->
        <div class="hidden md:flex flex-col justify-between p-12 bg-gradient-to-br from-indigo-600 via-purple-600 to-blue-700 text-white">
            <div>
                <span class="inline-block px-3 py-1 bg-white/10 backdrop-blur-md rounded-full text-xs font-semibold tracking-wider uppercase mb-6 border border-white/20">
                    GMBH Portal
                </span>
                <h1 class="text-4xl font-extrabold tracking-tight mb-4">
                    GMBH CMS System
                </h1>
                <p class="text-white/80 text-lg leading-relaxed">
                    Streamline your corporate digital infrastructure, manage enterprise assets, and control workflows
                    with maximum precision.
                </p>
            </div>

            <div class="text-xs text-white/60">
                &copy; @DateTime.Now.Year Nexalogic Enterprise Solutions. All rights reserved.
            </div>
        </div>

        <!-- Right Side: Login Form -->
        <div class="p-8 md:p-12 flex flex-col justify-center">
            <div class="max-w-md w-full mx-auto">

                <div class="mb-8">
                    <h2 class="@($"text-3xl font-bold {TitleColor} mb-2")">
                        Welcome Back
                    </h2>
                    <p class="@SubtitleColor">
                        Please enter your credentials to sign in.
                    </p>
                </div>

                <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                    <div class="mb-4">
                        <label class="@($"block text-sm font-medium {LabelColor} mb-2")">
                            Corporate Email
                        </label>
                        <InputText @bind-Value="loginModel.Email"
                                   placeholder="name@company-gmbh.com"
                                   class="@($"w-full rounded-xl {InputBg} border px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition")"/>
                    </div>

                    <div class="mb-6">
                        <div class="flex items-center justify-between mb-2">
                            <label class="@($"block text-sm font-medium {LabelColor}")">
                                Password
                            </label>
                            <a href="/forgot-password"
                               class="text-sm font-medium text-indigo-500 hover:underline">
                                Forgot Password?
                            </a>
                        </div>
                        <InputText type="password"
                                   @bind-Value="loginModel.Password"
                                   placeholder="••••••••"
                                   class="@($"w-full rounded-xl {InputBg} border px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition")"/>
                    </div>

                    <div class="flex items-center justify-between mb-6">
                        <label class="@($"{RememberMeColor} flex items-center gap-2 cursor-pointer text-sm")">
                            <InputCheckbox @bind-Value="loginModel.RememberMe"
                                           class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"/>
                            Remember Me
                        </label>
                    </div>

                    <button type="submit"
                            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 rounded-xl font-semibold shadow-lg shadow-indigo-600/20 transition duration-200">
                        Sign In to Dashboard
                    </button>
                </EditForm>

                <!-- Register Navigation Button -->
                <div class="mt-6">
                    <a href="/register"
                       class="@($"w-full flex items-center justify-center border {RegisterBtnBorder} py-3 rounded-xl font-semibold transition duration-200")">
                        Create Account
                    </a>
                </div>

                <div class="@($"mt-8 text-center text-sm {SubtitleColor}")">
                    Need system access provisioning?
                    <a href="/contact-admin" class="text-indigo-500 font-medium hover:underline">
                        Contact IT Admin
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private bool isDarkMode = false;

    private void ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        StateHasChanged();
    }

    private Task HandleLogin()
    {
        return Task.CompletedTask;
    }

    public class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; }
    }

    private string BgColor => isDarkMode ? "bg-slate-950 text-slate-100" : "bg-slate-50 text-slate-900";
    private string CardBg => isDarkMode ? "bg-slate-900 border-slate-800" : "bg-white border-slate-200";
    private string ButtonBg => isDarkMode ? "bg-slate-800 text-slate-300 hover:bg-slate-700" : "bg-slate-100 text-slate-700 hover:bg-slate-200";
    private string TitleColor => isDarkMode ? "text-white" : "text-slate-900";
    private string SubtitleColor => isDarkMode ? "text-slate-400" : "text-slate-500";
    private string LabelColor => isDarkMode ? "text-slate-300" : "text-slate-700";
    private string InputBg => isDarkMode ? "bg-slate-800 border-slate-700 text-white" : "bg-slate-50 border-slate-300 text-slate-900";
    private string RememberMeColor => isDarkMode ? "text-slate-400" : "text-slate-600";
    private string RegisterBtnBorder => isDarkMode ? "border-slate-700 hover:bg-slate-800 text-slate-300" : "border-slate-300 hover:bg-slate-50 text-slate-700";
}