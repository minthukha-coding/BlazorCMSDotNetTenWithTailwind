@inherits LayoutComponentBase

<head>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins {
            font-family: 'Poppins', sans-serif;
        }
    </style>
</head>

<div class="min-h-screen bg-[#F5F2F0] text-[#2D2424] flex font-poppins tracking-tight transition-colors duration-300">

    <!-- Sidebar -->
    <aside class="w-64 bg-[#FCFBFA] border-r border-[#E6E0DD] flex flex-col hidden md:flex">
        <!-- Logo / App Name -->
        <div class="h-20 flex items-center px-6 border-b border-[#E6E0DD]">
            <div>
                <span class="text-xs uppercase text-[#5C1D24] font-medium block tracking-normal">
                    Irrawaddy GmbH
                </span>
                <span class="text-xl font-semibold text-[#2D2424]">
                    CMS Portal
                </span>
            </div>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 p-4 space-y-2">
            <a href="/cms/edit-home" class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-[#E6E0DD]/50 text-[#735A5A] hover:text-[#2D2424] text-xs uppercase font-medium transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Home Edit
            </a>
            <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-[#E6E0DD]/50 text-[#735A5A] hover:text-[#2D2424] text-xs uppercase font-medium transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                Logout
            </a>
        </nav>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
        
        <!-- Top Navbar -->
        <header class="h-20 bg-[#FCFBFA] border-b border-[#E6E0DD] flex items-center justify-between px-8 z-20">
            <div class="flex items-center gap-4">
                <span class="text-xs uppercase font-medium text-[#5C4D4D] tracking-normal">Workspace</span>
            </div>

            <!-- Right Navbar Actions (Dropdown Profile) -->
            <div class="relative">
                <button @onclick="ToggleDropdown" 
                        class="flex items-center gap-3 bg-white border border-[#D9D0CC] hover:border-[#5C1D24] px-4 py-2.5 rounded-lg text-xs font-medium text-[#2D2424] transition cursor-pointer">
                    <div class="w-6 h-6 rounded-full bg-[#5C1D24] text-[#FCFBFA] flex items-center justify-center text-[10px] font-semibold">
                        A
                    </div>
                    <span>Admin User</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-[#735A5A] transition-transform duration-200 @(isDropdownOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                @if (isDropdownOpen)
                {
                    <!-- Dropdown Box -->
                    <div class="absolute right-0 mt-2 w-48 bg-[#FCFBFA] border border-[#E6E0DD] rounded-lg shadow-lg py-1.5 z-50">
                        <a href="/profile" class="flex items-center gap-2.5 px-4 py-2.5 text-xs text-[#2D2424] hover:bg-[#E6E0DD]/50 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#735A5A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Profile
                        </a>
                        <div class="border-t border-[#E6E0DD] my-1"></div>
                        <button @onclick="HandleLogout" class="w-full flex items-center gap-2.5 px-4 py-2.5 text-xs text-[#5C1D24] hover:bg-[#5C1D24]/10 transition text-left cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#5C1D24]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            Logout
                        </button>
                    </div>
                }
            </div>
        </header>

        <!-- Page Body Content -->
        <main class="flex-1 p-8 bg-[#F5F2F0]">
            <article class="max-w-6xl mx-auto">
                @Body
            </article>
        </main>
    </div>

</div>

@code {
    private bool isDropdownOpen = false;

    private void ToggleDropdown()
    {
        isDropdownOpen = !isDropdownOpen;
    }

    private void HandleLogout()
    {
        // Logout လုပ်သည့် Logic များကို ဤနေရာတွင် ထည့်သွင်းနိုင်ပါသည်
    }
}