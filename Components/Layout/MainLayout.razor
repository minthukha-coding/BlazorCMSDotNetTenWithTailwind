@using BlazorCMSDotNetTenWithTailwind.Components.Common
@inherits LayoutComponentBase

<head>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .font-poppins {
            font-family: 'Poppins', sans-serif;
        }

        @@keyframes spin-slow {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .animate-spin-custom {
            animation: spin-slow 1s linear infinite;
        }
    </style>
</head>

<div class="min-h-screen bg-[#F5F2F0] text-[#2D2424] flex font-poppins tracking-tight transition-colors duration-300">

    <!-- Sidebar Component ထည့်သွင်းခြင်း -->
    <Sidebar />

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">

        <!-- Top Navbar Component ထည့်သွင်းခြင်း -->
        <TopNavbar />

        <!-- Page Body Content -->
        <main class="flex-1 p-8 bg-[#F5F2F0]">
            <article class="max-w-6xl mx-auto">
                @Body
            </article>
        </main>
    </div>

</div>