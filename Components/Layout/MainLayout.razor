@inherits LayoutComponentBase

<div class="min-h-screen @(isDarkMode ? "bg-slate-950 text-slate-100" : "bg-slate-50 text-slate-900") flex transition-colors duration-300">

    <!-- Sidebar -->
    <aside class="w-64 @(isDarkMode ? "bg-slate-950" : "bg-white") flex flex-col hidden md:flex">
        <!-- Logo / App Name -->
        <div class="h-16 flex items-center px-6">
            <span class="text-xl font-bold bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
                GmbH CMS
            </span>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 p-4 space-y-1">
            <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl @(isDarkMode ? "bg-indigo-600/10 text-indigo-400" : "bg-indigo-50 text-indigo-600") font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                Dashboard
            </a>
            <a href="/profile" class="flex items-center gap-3 px-4 py-3 rounded-xl @(isDarkMode ? "hover:bg-slate-900 text-slate-400" : "hover:bg-slate-100 text-slate-600") font-medium transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                Profile Settings
            </a>
        </nav>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
        
        <!-- Top Navbar -->
        <header class="h-16 @(isDarkMode ? "bg-slate-950" : "bg-white") flex items-center justify-between px-6 z-20">
            <div class="flex items-center gap-4">
                <span class="text-sm font-semibold @(isDarkMode ? "text-slate-400" : "text-slate-500")">Enterprise Workspace</span>
            </div>

            <!-- Right Navbar Actions -->
            <div class="flex items-center gap-4">
                
                <!-- Theme Toggle Button -->
                <button type="button" @onclick="ToggleTheme" class="p-2 rounded-xl @(isDarkMode ? "bg-slate-900 text-slate-300 hover:bg-slate-800" : "bg-slate-100 text-slate-600 hover:bg-slate-200") transition" title="Toggle Theme">
                    @if (isDarkMode)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                        </svg>
                    }
                </button>

            </div>
        </header>

        <!-- Page Body Content -->
        <main class="flex-1 p-6">
            <article>
                @Body
            </article>
        </main>
    </div>

</div>

@code {
    private bool isDarkMode = true;

    private void ToggleTheme()
    {
        isDarkMode = !isDarkMode;
    }
}