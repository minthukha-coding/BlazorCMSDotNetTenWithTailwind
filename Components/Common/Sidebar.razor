<aside class="w-64 bg-[#FCFBFA] border-r border-[#E6E0DD] flex flex-col hidden md:flex">
    <!-- Sidebar Header with Logo -->
    <div class="p-6 border-b border-[#E6E0DD] flex flex-col items-center text-center bg-[#FCFBFA]">
        <div class="mb-2 w-full flex justify-center">
            <img src="./Logo/mainLogo.jpg" alt="Irrawaddy Munich Logo" class="h-16 w-auto object-contain"
                 style="mix-blend-mode: multiply;"/>
        </div>
        <span class="text-[10px] uppercase text-[#5C1D24] font-semibold tracking-wider">
            Irrawaddy GmbH Portal
        </span>
    </div>

    <!-- Navigation Links -->
    <nav class="flex-1 p-4 space-y-2">
        <!-- Dashboard -->
        <a href="/cms/dashboard"
           class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-[#E6E0DD]/50 text-[#735A5A] hover:text-[#2D2424] text-xs uppercase font-medium transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
            </svg>
            Dashboard
        </a>

        <!-- Home Edit -->
        <a href="/cms/edit-home"
           class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-[#E6E0DD]/50 text-[#735A5A] hover:text-[#2D2424] text-xs uppercase font-medium transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            Home Edit
        </a>

        <!-- About Edit -->
        <a href="/cms/edit-about"
           class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-[#E6E0DD]/50 text-[#735A5A] hover:text-[#2D2424] text-xs uppercase font-medium transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            About Edit
        </a>

        <!-- Service Edit -->
        <a href="/cms/edit-services"
           class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-[#E6E0DD]/50 text-[#735A5A] hover:text-[#2D2424] text-xs uppercase font-medium transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Service Edit
        </a>

        <!-- Current Focus Edit -->
        <NavLink href="/cms/edit-current-focus"
                 class="flex items-center gap-3 px-4 py-3 rounded-md text-[#735A5A] hover:bg-[#E6E0DD]/50 hover:text-[#2D2424] text-xs uppercase font-medium transition"
                 ActiveClass="bg-[#5C1D24] text-[#FCFBFA] hover:bg-[#5C1D24] hover:text-[#FCFBFA]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
            Current Focus Edit
        </NavLink>

        <!-- Why Choose Us & Vision Edit -->
        <NavLink href="/cms/edit-pillars-vision"
                 class="flex items-center gap-3 px-4 py-3 rounded-md text-[#735A5A] hover:bg-[#E6E0DD]/50 hover:text-[#2D2424] text-xs uppercase font-medium transition"
                 ActiveClass="bg-[#5C1D24] text-[#FCFBFA] hover:bg-[#5C1D24] hover:text-[#FCFBFA]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Pillars & Vision Edit
        </NavLink>

        <!-- Leadership Edit -->
        <NavLink href="/cms/edit-leadership"
                 class="flex items-center gap-3 px-4 py-3 rounded-md text-[#735A5A] hover:bg-[#E6E0DD]/50 hover:text-[#2D2424] text-xs uppercase font-medium transition"
                 ActiveClass="bg-[#5C1D24] text-[#FCFBFA] hover:bg-[#5C1D24] hover:text-[#FCFBFA]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            Leadership Edit
        </NavLink>

        <!-- Contact Edit -->
        <a href="/cms/edit-contact"
           class="flex items-center gap-3 px-4 py-3 rounded-md hover:bg-[#E6E0DD]/50 text-[#735A5A] hover:text-[#2D2424] text-xs uppercase font-medium transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2,2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Contact Edit
        </a>

        <!-- Logout Button -->
        <button @onclick="HandleLogout"
                class="w-full flex items-center gap-3 px-4 py-3 rounded-md hover:bg-[#E6E0DD]/50 text-[#735A5A] hover:text-[#2D2424] text-xs uppercase font-medium transition text-left cursor-pointer border-0 bg-transparent">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            Logout
        </button>
    </nav>
</aside>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private void HandleLogout()
    {
        NavigationManager.NavigateTo("/api/logout", true);
    }
}